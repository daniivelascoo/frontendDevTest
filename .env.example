# Dominio base del API de la prueba. Si no se define, se usa este mismo valor
# por defecto (ver src/api/config.js), de modo que el proyecto arranca sin
# configuración adicional.
VITE_API_BASE_URL=https://itx-frontend-test.onrender.com

# Tiempo de vida de la caché de cliente, en milisegundos.
# La prueba exige 1 hora = 3600000 ms.
VITE_CACHE_TTL_MS=3600000
